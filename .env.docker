# Variables de entorno específicas para el entorno Docker

# Pgvector Configuration (para comunicación entre contenedores)
PGVECTOR_HOST=pgvector_db
PGVECTOR_PORT=5432

# Celery Configuration (para comunicación entre contenedores)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# vLLM Configuration (para comunicación entre contenedores)
VLLM_BASE_URL=http://vllm:8000
VLLM_EMBED_BASE_URL=http://vllm-embedding:8000
VLLM_API_KEY=replace-with-secure-token
VLLM_CHAT_MODEL=qwen3:1.7b-q8_0
VLLM_CHAT_MODEL_PATH=Qwen/Qwen3-1.7B-Instruct
VLLM_EMBEDDING_MODEL=qwen3-embedding:8b
VLLM_EMBEDDING_MODEL_PATH=Qwen/Qwen3-Embedding-8B
VLLM_MARKDOWN_MODEL=
VLLM_IDLE_TIMEOUT_SECONDS=900
VLLM_REQUEST_TIMEOUT_SECONDS=60
VLLM_GPU_MEMORY_UTILIZATION=0.6
VLLM_EMBED_GPU_MEMORY_UTILIZATION=0.2
VLLM_HOST_PORT=8001
VLLM_EMBED_HOST_PORT=8002
VLLM_MAX_MODEL_LEN=32768
VLLM_HF_TOKEN=

# Moodle Configuration (para comunicación entre contenedores)
MOODLE_URL=http://moodle:8080

# Ollama Configuration (para comunicación entre contenedores)
OLLAMA_HOST=http://ollama:11434

# N8N Configuration (para comunicación entre contenedores)
N8N_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678

# Entorno de la aplicación
APP_ENV=docker
