# Use NVIDIA CUDA base image for GPU support with PaddleOCR
FROM --platform=linux/amd64 nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04 AS builder

# Install Python 3.10 and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-venv \
    python3.10-dev \
    python3-pip \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Make python3.10 the default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

RUN pip install --no-cache-dir uv

WORKDIR /app

# Create and activate virtual environment
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set UV environment variables for better caching and bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy requirements first to leverage Docker cache
COPY requirements.txt .

# Create a modified requirements file without paddlepaddle (we install it separately)
RUN grep -v "paddlepaddle" requirements.txt > requirements_no_paddle.txt || true

# Install PaddlePaddle GPU first from official source
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install paddlepaddle-gpu==3.0.0 -i https://www.paddlepaddle.org.cn/packages/stable/cu126/

# Install all other dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r requirements_no_paddle.txt

# Install system dependencies for PDF processing (poppler for pdf2image)
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      poppler-utils \
      libgomp1 \
      libgl1-mesa-glx \
      libglib2.0-0 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Copy the source code
COPY ./src ./src


FROM --platform=linux/amd64 nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04 AS final

WORKDIR /app

# Create a non-root user for security
ENV APP_USER=appuser
RUN groupadd -r ${APP_USER} && useradd --no-log-init -r -g ${APP_USER} ${APP_USER}

# Install Python 3.10 and system dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.10 \
      python3.10-venv \
      poppler-utils \
      libgomp1 \
      libgl1-mesa-glx \
      libglib2.0-0 \
      curl \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Make python3.10 the default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# Copy virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv

# Copy source code from builder stage and set ownership
COPY --from=builder --chown=${APP_USER}:${APP_USER} /app/src ./src

# Set PYTHONPATH to include the app directory
ENV PYTHONPATH=/app

# Add virtual environment to PATH
ENV PATH="/opt/venv/bin:$PATH"

# Environment variables for PaddleOCR GPU
ENV OMP_THREAD_LIMIT=1
ENV CUDA_VISIBLE_DEVICES=0
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# PaddleOCR will download models to this directory
ENV PADDLEOCR_HOME=/app/.paddleocr
RUN mkdir -p /app/.paddleocr && chown -R ${APP_USER}:${APP_USER} /app/.paddleocr

# Create data directories and set ownership before switching to appuser
RUN mkdir -p /app/data/downloads && \
    mkdir -p /app/data/markdown_files && \
    chown -R ${APP_USER}:${APP_USER} /app

# Switch to non-root user
USER ${APP_USER}

# Expose the port the FastAPI app will run on
EXPOSE 8000

# Command to run the FastAPI application using Uvicorn
CMD ["uvicorn", "src.entrenai.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "3"]
